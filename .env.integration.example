# External dedicated lab endpoint. Copy to .env.integration and fill in locally.
# Process environment variables override this file.
UBQ_TEST_HOST=127.0.0.1
UBQ_TEST_PORT=2222
UBQ_TEST_USER=ubqtest
UBQ_TEST_SSH_KEY=.cache/lab/id_ed25519
UBQ_TEST_KNOWN_HOSTS=.cache/lab/known_hosts
UBQ_TEST_EXPECT_HOSTNAME=ubq-test-router
UBQ_TEST_TIMEOUT=2m
# Use a password instead of SSH_KEY if required; never commit actual credentials.
# UBQ_TEST_PASSWORD=
# UBQ_TEST_KEY_PASSPHRASE=

# For make smoke-docker only: an already imported VyOS OCI image.
# Use the exact image ID reported by docker image inspect; no automatic pulls.
# UBQ_VYOS_IMAGE=sha256:<image-id>
