service {
    ssh {
        disable-password-authentication
        port 22
    }
}
system {
    config-management {
        commit-revisions 20
        commit-confirm {
            action reload
        }
    }
    host-name ubq-test-router
    static-host-mapping {
        host-name retained.example {
            inet 198.51.100.10
        }
        host-name added.example {
            inet 203.0.113.10
        }
    }
    login {
        user ubqtest {
            authentication {
                public-keys smoke {
                    key "{{SSH_KEY}}"
                    type ssh-ed25519
                }
            }
        }
    }
}

{{CONFIG_VERSION}}
