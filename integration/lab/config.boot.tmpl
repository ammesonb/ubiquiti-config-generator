service {
    ssh {
        disable-password-authentication
        port 22
    }
}
system {
    config-management {
        commit-revisions 20
        commit-confirm {
            action reload
        }
    }
    host-name ubq-test-router
    login {
        user ubqtest {
            authentication {
                public-keys smoke {
                    key "{{SSH_KEY}}"
                    type ssh-ed25519
                }
            }
        }
    }
}
